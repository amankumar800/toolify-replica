# ============================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env.local and fill in your values
# ============================================

# SUPABASE (Required for Authentication and Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# DATABASE CONNECTION POOLING (For Direct DB Access)
# ============================================
# NOTE: The Supabase JS client (@supabase/supabase-js, @supabase/ssr) uses
# the REST API (PostgREST), which already handles connection pooling automatically.
# These DATABASE_URL variables are ONLY needed if you use direct PostgreSQL
# connections (e.g., Prisma, Drizzle, raw pg client).
#
# Supavisor Connection Pooler (recommended for serverless like Vercel):
# - Port 6543: Transaction Mode (best for serverless - short-lived connections)
# - Port 5432: Session Mode (for migrations, long-running connections)
#
# Get your pooler URL from: Supabase Dashboard → Settings → Database → Connection string
# Select "Transaction pooler" for serverless deployments

# Transaction Mode (Port 6543) - Use for serverless functions
# DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Session Mode (Port 5432) - Use for migrations and long-running connections
# DIRECT_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# DATABASE CONNECTION POOLING (For Direct Postgres Access)
# Supavisor connection pooler - use Transaction mode (port 6543) for serverless
# Get your database password from: Supabase Dashboard → Settings → Database
#
# Transaction mode pooler (RECOMMENDED for Vercel serverless)
# DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Direct connection (for migrations)
# DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# APPLICATION
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Site URL for canonical URLs, sitemap, and SEO
# Set to your production domain in Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL SERVICES
# OPENAI_API_KEY=sk-your-openai-api-key
# SENDGRID_API_KEY=your-sendgrid-api-key
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=your-twilio-auth-token
# S3_HOST=your-bucket.s3-region.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-aws-access-key
# S3_SECRET_KEY=your-aws-secret-key

# ADMIN CONFIGURATION
# Used by scripts/setup-admin.ts to create the admin user
ADMIN_EMAIL=admin@aitoolsbook.com
ADMIN_PASSWORD=Admin@123!Secure

# JWT secret for admin session tokens (generate a secure random string)
# Example: openssl rand -base64 32
ADMIN_JWT_SECRET=your-secure-jwt-secret-here

# UPSTASH REDIS (Optional - for API rate limiting)
# Sign up at https://upstash.com and create a Redis database
# Rate limiting is disabled if these are not set
# 
# Rate Limit Tiers:
# - login: 5 requests per 15 minutes (brute-force protection)
# - adminMutation: 60 requests per minute (write operations)
# - bulkOperation: 10 requests per minute (bulk delete/update)
# - adminRead: 300 requests per minute (read operations)
# - public: 100 requests per minute (public API endpoints)
# - global: 200 requests per 10 seconds (middleware-level DDoS protection)
#
# UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# SENTRY (Recommended - for error tracking and monitoring)
# Sign up at https://sentry.io and create a Next.js project
# Error tracking is disabled if DSN is not set
#
# Get your DSN from: Settings > Projects > [Your Project] > Client Keys (DSN)
# NEXT_PUBLIC_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
#
# For source map uploads (optional but recommended for production):
# Get auth token from: Settings > Auth Tokens
# SENTRY_AUTH_TOKEN=your-sentry-auth-token
# SENTRY_ORG=your-sentry-org-slug
# SENTRY_PROJECT=your-sentry-project-slug

# ============================================
# CACHE REVALIDATION
# ============================================
# Secret key for on-demand cache revalidation endpoint (/api/revalidate)
# Generate a secure random string: openssl rand -base64 32
# Call the endpoint after admin CRUD operations to refresh cached data
#
# Available tags:
# - tools: Revalidate tool listings
# - categories: Revalidate category data
# - featured-tools: Revalidate homepage featured tools
# - news: Revalidate AI news
# - stats: Revalidate homepage stats
#
# REVALIDATION_SECRET=your-secure-revalidation-secret-here
